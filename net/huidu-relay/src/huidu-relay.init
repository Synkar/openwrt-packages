#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/huidu-relay \
		-device 192.168.11.200 \
		-advertise 10.0.3.27 \
		-udp 9527 \
		-tcp 9527
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
